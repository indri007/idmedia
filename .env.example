# ==============================================================================
# IDMedia & QA Automation - Environment Configuration Example (.env.example)
# Salin berkas ini menjadi .env untuk konfigurasi lokal: cp .env.example .env
# JANGAN PERNAH menyertakan file .env yang berisi kredensial asli ke Git.
# ==============================================================================

# 1. Konfigurasi Basis Data Awan Opsional (Supabase)
# Biarkan kosong jika menggunakan SQLite lokal bawaan (platform.db)
SUPABASE_URL=
SUPABASE_KEY=

# 2. Pengaturan Peramban Pengujian (Robot Framework)
IDN_BROWSER=chrome
IDNTIMES_COMMUNITY_URL=https://community.idntimes.com/
IDNTIMES_BASE_URL=https://www.idntimes.com/
POPBELA_BASE_URL=https://www.popbela.com/
POPMAMA_BASE_URL=https://www.popmama.com/

# 3. Kredensial Akun Pengujian QA (Gunakan akun pengujian berwenang, bukan akun produksi)
IDN_TEST_EMAIL=test_author@example.com
IDN_TEST_PASSWORD=secure_test_password

# 4. Kredensial Pendaftaran Pengujian (Signup QA)
IDN_REG_EMAIL=test_registration@example.com
IDN_REG_PASSWORD=secure_reg_password
